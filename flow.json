      "cle": "departements",
      "filtre_source": "marche_par_departement",
      "next": "infos_marche_infos_type",
      "json_response_contrat": "{}",
      "comment": "Filtre interne : réduit la liste des marchés proposés au département choisi, via le hashmap marche_par_departement."
    },
    "infos_marche_infos_type": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "infos_marche_infos_type_intro",
        "sequence": ["questions/infos_marche_infos_type.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "type_info_marche",
      "set": "type_info_marche",
      "next": "infos_marche_result",
      "json_response_contrat": "{}",
      "comment": "Choix du type d'information souhaité sur le marché (résumé, calendrier, produits disponibles...)."
    },
    "infos_marche_result": {
      "type": "result",
      "data_source": {
        "endpoint": "api/app/infos_marches",
        "params": ["marche", "info_type"]
      },
      "audio": {
        "type": "sequence",
        "key": "infos_marche_result_intro",
        "sequence": ["questions/infos_marche_result.mp3"],
        "fallback": "intro/default.mp3"
      },
      "json_response_contrat": "{\n  \"type\": \"calendar\",\n  \"version\": \"1.0\",\n  \"data\": {\n    \"marche\": { \"id\": 12, \"nom\": \"takon\" },\n    \"regle\": { \"type\": \"hebdomadaire\", \"valeur\": { \"jours\": [2, 5] } },\n    \"description\": \"Marché tous les mardi et vendredi\",\n    \"intro\": [\"intro/calendrier_marche.mp3\", \"marches/takon.mp3\"],\n    \"outro\": [\"frequence/hebdomadaire.mp3\"]\n  }\n}",
      "response_examples": [],
      "comment": "Informations sur le marché choisi. La règle de calendrier peut être hebdomadaire, par intervalle ou mensuelle (voir json_response_contrat)."
    },
    "explorer_produit_produit": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "explorer_produit_produit_intro",
        "sequence": ["questions/explorer_produit_produit.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "produits",
      "set": "produits",
      "next": "explorer_produit_marche",
      "json_response_contrat": "{}",
      "comment": "Choix du produit dont on veut explorer l'historique des prix."
    },
    "explorer_produit_marche": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "explorer_produit_marche_intro",
        "sequence": ["questions/explorer_produit_marche.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "marches_suivis",
      "set": "marches_suivis",
      "next": "explorer_produit_periode",
      "json_response_contrat": "{}",
      "comment": "Choix du marché suivi pour l'historique des prix."
    },
    "explorer_produit_periode": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "explorer_produit_periode_intro",
        "sequence": ["questions/explorer_produit_periode.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "periode",
      "set": "periode",
      "next": "explorer_produit_result",
      "json_response_contrat": "{}",
      "comment": "Choix de la période d'historique des prix à afficher."
    },
    "explorer_produit_result": {
      "type": "result",
      "data_source": {
        "endpoint": "explorer_prix",
        "params": ["marche", "produit", "periode"]
      },
      "audio": {
        "type": "sequence",
        "key": "explorer_produit_result_intro",
        "sequence": ["questions/explorer_produit_result.mp3"],
        "fallback": "intro/default.mp3"
      },
      "json_response_contrat": "{}",
      "response_examples": [
        "{\n  \"type\": \"audio_sequence\",\n  \"sequence\": [\n    { \"audios\": [\"intro/historique_prix.mp3\", \"{produit}\", \"intro/dans_marche.mp3\", \"{marche}\", \"{periode}\"], \"image\": \"images/intro/historique.png\" },\n    { \"audios\": [\"{date:2026-01-10}\"], \"image\": null },\n    { \"audios\": [\"produits/mais_local.mp3\", \"phrases/est_a.mp3\", \"{prix:8000}\", \"unites/bassine_10kg.mp3\"], \"image\": \"images/produits/mais_local.png\" },\n    { \"audios\": [\"variation/hausse.mp3\", \"conseils/tendance_hausse.mp3\"], \"image\": \"images/icons/trend_up.png\" }\n  ]\n}"
      ],
      "comment": "Historique des prix : le backend regroupe les prix par date, ne garde que les dates où le prix change, calcule la tendance (hausse/baisse/stable) et génère un conseil final."
    }
