      "next": "explorer_produit_marche_filter",
      "json_response_contrat": "{}",
      "comment": "Choix du département pour explorer les informations d'un marché."
    },
    "explorer_produit_marche_filter": {
      "type": "pre_filter",
      "audio": {
        "type": "sequence",
        "key": "explorer_produit_marche_filter_intro",
