  "dynamic_audio": {},
  "nodes": {
    "root": {
      "type": "root",
      "audio": {
        "type": "sequence",
        "key": "root_intro",
        "sequence": ["intro/root.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options": [
        { "id": "achete_produit", "next": "achete_produit" },
        { "id": "vendre_produit", "next": "vendre_produit" },
        { "id": "marche_anime_x", "next": "marche_anime_x" },
        { "id": "marche_anime_calendrier", "next": "anime_calendrier_calendrier" },
        { "id": "infos_march", "next": "infos_marche_departement" },
        { "id": "explorer_produit", "next": "explorer_produit_produit" }
      ],
      "json_response_contrat": "{}",
      "comment": "Menu principal du flow AgroFlux : point d'entrée de tous les parcours."
    },
    "achete_produit": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "achete_produit_intro",
        "sequence": ["intro/achete_produit_intro.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "produits",
      "set": "produits",
      "next": "acheter_result",
      "json_response_contrat": "{}",
      "comment": "Nœud de démarrage du flow \"acheter un produit\". Permet de choisir le produit à acheter."
    },
    "vendre_produit": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "vendre_produit_intro",
        "sequence": ["intro/vendre_produit_intro.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "produits",
      "set": "produits",
      "next": "vendre_result",
      "json_response_contrat": "{}",
      "comment": "Nœud de démarrage du flow \"vendre un produit\". Permet de choisir le produit à vendre."
    },
    "marche_anime_x": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "marche_anime_x_intro",
        "sequence": ["questions/marche_anime_x.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "x_anime_x",
      "set": "x_anime_x",
      "next": "anime_x_departement",
      "json_response_contrat": "{}",
      "comment": "Choix du jour (aujourd'hui, demain, etc.) pour connaître les marchés animés."
    },
    "acheter_result": {
      "type": "result",
      "data_source": {
        "endpoint": "api/app/acheter_produit",
        "params": ["produit", "departement"]
      },
      "audio": {
        "type": "sequence",
        "key": "acheter_result_intro",
        "sequence": ["intro/acheter_result.mp3"],
        "fallback": "intro/default.mp3"
      },
      "json_response_contrat": "{\n  \"type\": \"audio_sequence\",\n  \"version\": \"1.0\",\n  \"sequence\": [\n    { \"audios\": [\"intro/vous_cherchez_acheter.mp3\", \"{produit}\", \"intro/dans_departement.mp3\", \"{departement}\"], \"image\": \"images/intro/acheter.png\" },\n    { \"audios\": [\"ordre/premier_marche.mp3\", \"marches/bohicon.mp3\", \"{date:2026-03-10}\"], \"image\": \"images/marches/bohicon.png\" },\n    { \"audios\": [\"produits/mais_local.mp3\", \"phrases/est_a.mp3\", \"{prix:1000}\", \"unites/kg.mp3\"], \"image\": \"images/produits/mais_local.png\" }\n  ],\n  \"meta\": { \"auto_play\": true, \"pause_ms\": 600 }\n}",
      "response_examples": [],
      "comment": "Résultats du parcours \"acheter un produit\" : liste des marchés avec les meilleurs prix pour le produit choisi."
    },
    "vendre_result": {
      "type": "result",
      "data_source": {
        "endpoint": "api/app/vendre_produit",
        "params": ["produit", "departement"]
      },
      "audio": {
        "type": "sequence",
        "key": "vendre_result_intro",
        "sequence": ["intro/vendre_result.mp3"],
        "fallback": "intro/default.mp3"
      },
      "json_response_contrat": "{\n  \"type\": \"audio_sequence\",\n  \"version\": \"1.0\",\n  \"sequence\": [\n    { \"audios\": [\"intro/vous_cherchez_vendre.mp3\", \"{produit}\", \"intro/dans_departement.mp3\", \"{departement}\"], \"image\": \"images/intro/vendre.png\" },\n    { \"audios\": [\"ordre/premier_marche.mp3\", \"marches/bohicon.mp3\", \"{date:2026-03-10}\"], \"image\": \"images/marches/bohicon.png\" },\n    { \"audios\": [\"produits/mais_local.mp3\", \"phrases/est_vendu_a.mp3\", \"{prix:1000}\", \"unites/kg.mp3\"], \"image\": \"images/produits/mais_local.png\" }\n  ],\n  \"meta\": { \"auto_play\": true, \"pause_ms\": 600 }\n}",
      "response_examples": [],
      "comment": "Résultats du parcours \"vendre un produit\" : liste des marchés avec les meilleurs prix de vente pour le produit choisi."
    },
    "anime_x_departement": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "anime_x_departement_intro",
        "sequence": ["questions/anime_x_departement.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "departements_et_tout",
      "set": "departements_et_tout",
      "next": "anime_x_result",
      "json_response_contrat": "{}",
      "comment": "Choix du département (ou tous les départements) pour la liste des marchés animés à la date choisie."
    },
    "anime_x_result": {
      "type": "result",
      "data_source": {
        "endpoint": "api/app/anime_x",
        "params": ["date", "departement"]
      },
      "audio": {
        "type": "sequence",
        "key": "anime_x_result_intro",
        "sequence": ["intro/anime_x_result.mp3"],
        "fallback": "intro/default.mp3"
      },
      "json_response_contrat": "{}",
      "response_examples": [
        "{\n  \"type\": \"audio_sequence\",\n  \"sequence\": [\n    { \"audios\": [\"intro/les_marches_actifs_sont.mp3\", \"{date:2026-03-10}\"], \"image\": \"images/calendar/date.png\" },\n    { \"audios\": [\"location/dans_le_departement.mp3\", \"{departement}\"], \"image\": \"images/localites/atlantique.png\" },\n    { \"audios\": [\"marches/bohicon.mp3\"], \"image\": \"images/marches/bohicon.png\" }\n  ]\n}"
      ],
      "comment": "Liste des marchés animés à la date et dans le département choisis."
    },
    "anime_calendrier_calendrier": {
      "type": "calendrier",
      "audio": {
        "type": "sequence",
        "key": "anime_calendrier_calendrier_intro",
        "sequence": ["questions/date_anime_calendrier_calendrier.mp3"],
        "fallback": "intro/default.mp3"
      },
      "periode": 7,
      "cadran": "centrer",
      "next": "anime_calendrier_departement",
      "json_response_contrat": "{}",
      "comment": "Sélection de la date (widget calendrier) pour connaître les marchés animés."
    },
    "anime_calendrier_departement": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "anime_calendrier_departement_intro",
        "sequence": ["questions/anime_calendrier_departement.mp3"],
        "fallback": "intro/default.mp3"
      },
      "options_source": "departements_et_tout",
      "set": "departements_et_tout",
      "next": "anime_calendrier_result",
      "json_response_contrat": "{}",
      "comment": "Choix du département après sélection de la date via le calendrier."
    },
    "anime_calendrier_result": {
      "type": "result",
      "data_source": {
        "endpoint": "api/app/anime_calendrier",
        "params": ["date", "departement"]
      },
      "audio": {
        "type": "sequence",
        "key": "anime_calendrier_result_intro",
        "sequence": ["intro/anime_calendrier_result.mp3"],
        "fallback": "intro/default.mp3"
      },
      "json_response_contrat": "{}",
      "response_examples": [],
      "comment": "Liste des marchés animés pour la date sélectionnée via le calendrier."
    },
    "infos_marche_departement": {
      "type": "grid",
      "audio": {
        "type": "sequence",
        "key": "infos_marche_departement_intro",
